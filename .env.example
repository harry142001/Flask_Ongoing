# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Path to the main properties database (default: data/Database1.db)
DB_PATH=data/Database1.db

# Path to the property details database (default: data/property_details.db)
DETAILS_DB_PATH=data/property_details.db

# Database table name (default: properties)
TABLE=properties

# Port the server listens on (default: 5002)
PORT=5002
